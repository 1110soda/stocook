<h1>プロフィール設定</h1>

<%= form_with model: @user, local: true do |f| %>

  <div>
    <%= f.label :allergies, "アレルギー・苦手な食材" %><br>
    <%= f.text_area :allergies, placeholder: "例: エビ、ピーマン、辛いもの" %>
  </div>

  <div>
    <%= f.label :appetite, "一食の量" %><br>
    <%= f.select :appetite, ["少なめ", "普通", "多め", "ガッツリ"], include_blank: "選択してください" %>
  </div>

  <div style="margin-top: 10px;">
    <%= f.submit "更新" %>
  </div>
<% end %>

<%= link_to '戻る', user_path(@user) %>