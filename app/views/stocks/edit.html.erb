<h1>食材編集</h1>

<%= form_with model: @stock, local: true do |f| %>
    <div>
        <%= f.label :name, "食材" %><br>
        <%= f.text_field :name %>
    </div>
    <div>
        <%= f.label :category, "カテゴリー" %><br>
        <%= f.select :category, Stock::CATEGORIES, { include_blank: '選択してください' } %>
    </div>
    <div>
        <%= f.label :quantity, "残量" %><br>
        <%= f.text_field :quantity %>
    </div>
    <div>   
        <%= f.label :expiration_date, "賞味期限" %><br>
        <%= f.date_field :expiration_date %>
    </div>
    <%= f.submit "更新" %>
<% end %>

<%= link_to '戻る', stocks_path %>