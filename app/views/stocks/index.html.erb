<h1>stocook</h1>

<div style="text-align: right; margin-bottom: 10px;">
    <%= Time.zone.now.strftime("%Y年%m月%d日 %H:%M") %>
</div>

<% 
    expiring_stocks = []
    @stocks.each do |stock|
        if stock.expiration_date && stock.expiration_date <= Time.zone.now.to_date + 2
            expiring_stocks.push(stock)
        end
    end
%>

<% if expiring_stocks.size > 0 %>
    <div style="color: red; border: 2px solid red; padding: 10px; margin-bottom: 15px;">
    <h3>!賞味期限アラート!</h3>
    <% expiring_stocks.each do |stock| %>
        <%= stock.name %>
        &lt;残<%= (stock.expiration_date - Time.zone.now.to_date).to_i %>日&gt;<br>
    <% end %>
    </div>
<% end %>

<%= link_to '食材登録', new_stock_path %>

<table border="1">
    <thead>
        <tr>
            <th>食材［カテゴリー］</th>
            <th>残量</th>
            <th>賞味期限</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        <% @stocks.each do |stock| %>
            <tr>
                <td><%= stock.name %>［<%= stock.category %>］</td>
                <td><%= stock.quantity %></td>
                <td><%= stock.expiration_date %></td>
                <td>
                    <div style="display: flex; align-items: center; gap: 5px;">
                        <%= link_to '編集', edit_stock_path(stock) %>
                        <%= button_to '削除', stock_path(stock), method: :delete %>
                    </div>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>